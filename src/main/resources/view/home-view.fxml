<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.bts.iris.slam.controller.HomeController" stylesheets="view/stylesheet.css">

    <top><HBox>

            <HBox alignment="CENTER" style="-fx-border-color: #000000; -fx-border-style: hidden hidden solid hidden;" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="big, bold" text="FrameLab" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER">
                    <Text fx:id="userName" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="big, bold" text="NaN"/>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="big" text="Utilisateur"/>
                </HBox>
                <HBox.margin>
                    <Insets />
                </HBox.margin>
            <padding>
               <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
            </HBox>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>

    </HBox></top>



    <left><HBox>

            <HBox style="-fx-border-color: #000000; -fx-border-style: hidden hidden hidden hidden;" BorderPane.alignment="CENTER">
                <padding><Insets bottom="0.0" left="0.0" right="0.0" top="0.0" /></padding>
                <VBox>

                </VBox>
            </HBox>

    </HBox></left>



    <center><HBox HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">

                <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">

                    <VBox fx:id="currentChallengeVbox" alignment="CENTER" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER">
                            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>

                            <VBox alignment="CENTER" spacing="10" HBox.hgrow="NEVER">

                                <Region prefHeight="16" />

                                <ImageView fx:id="challengeImage">
                                    <fitWidth>512</fitWidth>
                                    <fitHeight>256</fitHeight>
                                    <preserveRatio>true</preserveRatio>
                                </ImageView>
                                <VBox VBox.vgrow="ALWAYS">
                                    <Text fx:id="challengeStartDateText" />
                                    <Text fx:id="challengeEndDateText" />
                                </VBox>

                            </VBox>

                            <VBox HBox.hgrow="ALWAYS">
                                <Text fx:id="challengeTitleText" styleClass="big, bold"> </Text>
                                <Text fx:id="challengeDescriptionText" styleClass="bold"> </Text>
                            </VBox>

                        </HBox>

                        <Region prefHeight="64" />
                        <Label text="Téléchargez l'image du challenge actuel" />
                        <TextField fx:id="challengeTextField" styleClass="text-field" promptText="Nom de l'image enregistré" />
                        <Region prefHeight="16" />
                        <Button fx:id="challengeDownloadButton" styleClass="button" text="Télécharger" />

                    </VBox>

                    <Label fx:id="challengeFeedbackLabel" />
                    <Region prefHeight="32" />
                    <Button onAction="#logout" styleClass="button" text="Déconnexion" />
                    <Region prefHeight="16" />

                </VBox>

            <padding>
               <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>

            </HBox>

    </HBox></center>



   <right><HBox>

            <HBox style="-fx-border-color: #000000; -fx-border-style: hidden hidden hidden solid;" BorderPane.alignment="CENTER">
                <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>

                <VBox>
                    <ScrollPane styleClass="scroll-pane">
                        <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>

                        <VBox fx:id="projectsSection">
                            <!-- Content generated by the controller -->
                        </VBox>

                    </ScrollPane>
                    <HBox>
                        <TextField fx:id="projectNameField" styleClass="text-field" promptText="Nom du project" />
                        <Button onAction="#handleCreateProject" styleClass="button" text="Créer" />
                    </HBox>
                </VBox>

            </HBox>

   </HBox></right>



   <bottom><HBox HBox.hgrow="ALWAYS">

          <HBox style="-fx-border-color: #000000; -fx-border-style: hidden hidden hidden hidden;" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">
              <padding><Insets bottom="0.0" left="0.0" right="0.0" top="0.0" /></padding>

              <VBox>

              </VBox>

          </HBox>

   </HBox></bottom>

</BorderPane>
