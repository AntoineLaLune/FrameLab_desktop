    <center><HBox HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">
            <VBox fx:id="editorZone" alignment="CENTER" spacing="10" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
                <!-- Content generated by the controller -->
            </VBox>
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
        </HBox>

    </HBox></center>

    <right><HBox>
        <VBox fx:id="editorRight" spacing="8.0" style="-fx-border-color: #000000; -fx-border-style: hidden hidden hidden solid;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>

            <Region VBox.vgrow="ALWAYS" />

            <ScrollPane>
                <VBox fx:id="layersSection" spacing="8.0">
                    <!-- Content generated by the controller -->
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox></right>

    <bottom><HBox HBox.hgrow="ALWAYS">
        <HBox fx:id="editorBottom" style="-fx-border-color: #000000; -fx-border-style: solid hidden hidden hidden;" BorderPane.alignment="CENTER" HBox.hgrow="ALWAYS">
            <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>

            <Label fx:id="feedbackLabel" text=" "/>

            <Region HBox.hgrow="ALWAYS" />

        </HBox>
    </HBox></bottom>

</BorderPane>
