<?import javafx.scene.control.Label?>
<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.bts.iris.slam.controller.EditorController" stylesheets="view/stylesheet.css">

    <top><HBox>
        <VBox fx:id="editorTop" prefHeight="44.0" prefWidth="0.0" style="-fx-border-color: #000000; -fx-border-style: hidden hidden solid hidden;" HBox.hgrow="ALWAYS">

            <HBox alignment="CENTER">
                <MenuButton mnemonicParsing="false" styleClass="menu-button" text="Fichier" textFill="WHITE">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#submit" text="Sauvegarder &amp; Envoyer" />
                        <MenuItem mnemonicParsing="false" onAction="#save" text="Sauvegarder" />
                        <MenuItem mnemonicParsing="false" onAction="#exit" text="Quitter" />
                    </items>
                </MenuButton>
                <Region prefHeight="26.0" prefWidth="16.0" />
                <MenuButton mnemonicParsing="false" styleClass="menu-button" text="Effects" textFill="WHITE">
                    <items>
                        <MenuItem fx:id="grayColors" mnemonicParsing="false" onAction="#selectFiler" text="Noir et blanc" />
                        <MenuItem fx:id="inverseColors" mnemonicParsing="false" onAction="#selectFiler" text="Négatif linéaire" />
                        <MenuItem fx:id="rotate" mnemonicParsing="false" onAction="#selectFiler" text="Rotation" />
                    </items>
                </MenuButton>
                <Region HBox.hgrow="ALWAYS" />
                <padding>
                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                </padding>
            </HBox>

            <!-- Second HBox generated by the controller -->

        </VBox>
    </HBox></top>

